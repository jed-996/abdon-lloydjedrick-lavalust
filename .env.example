APP_ENV=production
APP_URL=https://your-service.onrender.com
APP_KEY=
# Required for the API. Run php lava jwt:generate to generate both keys in .env.
JWT_SECRET=
REFRESH_TOKEN_KEY=
FRONTEND_ORIGIN=https://your-service.onrender.com
DB_DRIVER=mysql
DB_HOST=
DB_PORT=
DB_USERNAME=avnadmin
DB_PASSWORD=
DB_NAME=defaultdb
DB_SSL_REQUIRED=true
DB_SSL_CA=/var/www/html/certs/ca.pem
ADMIN_EMAIL=
# Run php scripts/hash-password.php; paste the hash, never the plaintext password.
ADMIN_PASSWORD_HASH=
